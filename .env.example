# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gift_exchange?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional in local development; required to enable Google sign-in).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Used to build password-reset and email-verification links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP is optional locally. In production, configure all fields to deliver account emails.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Gift Exchange <no-reply@example.com>"

# Protects the scheduled account-retention endpoint. Generate like AUTH_SECRET.
CRON_SECRET="replace-with-a-separate-long-random-secret"
